{
  "id": "forecastreceipt",
  "title": "Forecast Receipt",
  "description": "Follow one weather hour at Langley or Halifax from its first saved temperature forecast through later revisions to the airport reading.",
  "category": "places",
  "tags": [
    "weather",
    "forecasts",
    "stations",
    "temperature"
  ],
  "icon": "history",
  "url": "/forecastreceipt/",
  "source": "https://github.com/jsdyer/forecastreceipt",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "Six-hourly forecast receipts are matched to hourly temperatures from Environment and Climate Change Canada at two airports.",
    "cadence": "Every 6 hours",
    "probes": [
      {
        "url": "https://coolcode.ca/forecastreceipt/data/index.json",
        "path": [
          "last_capture"
        ],
        "label": "Latest capture",
        "count_at": {
          "path": [
            "receipts"
          ],
          "unit": "station forecasts",
          "measure": "length"
        },
        "precision": "minute"
      },
      {
        "url": "https://coolcode.ca/forecastreceipt/data/index.json",
        "path": [
          "first_capture"
        ],
        "label": "Archive began",
        "count_at": {
          "path": [
            "forecast_points"
          ],
          "unit": "forecast points"
        }
      }
    ]
  }
}
